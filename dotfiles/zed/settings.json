  "bottom_dock_layout": "contained",
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "tab_bar": {
    "show": true
  },
  "title_bar": {
    "open_menus_on_hover": false,
    "show_menus": false,
    "show_branch_status_icon": true
  },
  "debugger": {
    "button": true
  },
  "search": {
    "button": true
  },
  "edit_predictions": {
    "button": false
  },
  "diagnostics": {
    "button": true
  },
  "status_bar": {
    "show_active_file": true,
