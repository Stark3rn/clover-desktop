{
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "collaboration_panel": {
    "button": true
  },
  "git_panel": {
    "file_icons": true,
    "button": true
  },
  "outline_panel": {
    "button": true
  },
